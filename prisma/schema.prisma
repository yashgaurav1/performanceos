datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

model User {
  id                 String               @id @default(cuid())
  email              String               @unique
  passwordHash       String
  name               String
  goalType           String               @default("MAINTAIN") // CUT, MAINTAIN, BULK
  targetRatePerWeek  Float                @default(0.0) // backward-compatible
  targetWeeklyRateKg Float                @default(0.0)
  currentTdeeKcal    Int                  @default(2400)
  targetCalories     Int                  @default(2200)
  targetProteinG     Int                  @default(180)
  targetCarbsG       Int                  @default(220)
  targetFatG         Int                  @default(65)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @default(now()) @updatedAt

  // Core production relations
  telemetries        DailyTelemetry[]
  foodLogs           FoodLogEntry[]
  studySessions      StudySessionLog[]
  transactions       ExpenseTransaction[]
  coachCheckIns      WeeklyCoachCheckIn[]

  // Backward compatibility relations
  dailyLogs          DailyLog[]
  weeklyCheckIns     WeeklyCheckIn[]
}

model DailyTelemetry {
  id                        String         @id @default(cuid())
  userId                    String
  user                      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  date                      String         // YYYY-MM-DD
  rawScaleWeightKg          Float?
  ewmaTrendWeightKg         Float?
  totalCaloriesIn           Int            @default(0)
  totalProteinG             Float          @default(0)
  totalCarbsG               Float          @default(0)
  totalFatG                 Float          @default(0)
  calculatedRollingTdeeKcal Int            @default(2400)
  adherenceScore            Int            @default(80)
  sleepHours                Float?
  sleepQuality              Int?           // 1-5
  subjectiveMood            Int?           // 1-5
  energyLevel               Int?           // 1-5
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  foodEntries               FoodLogEntry[]

  @@unique([userId, date])
}

model FoodLogEntry {
  id               String          @id @default(cuid())
  dailyTelemetryId String?
  dailyTelemetry   DailyTelemetry? @relation(fields: [dailyTelemetryId], references: [id], onDelete: SetNull)
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodName         String
  brandName        String?
  barcode          String?
  servingWeightG   Float           @default(100)
  caloriesKcal     Float
  proteinG         Float
  carbsG           Float
  fatG             Float
  mealSlot         String          @default("SNACK") // BREAKFAST, LUNCH, DINNER, SNACK
  loggedAt         DateTime        @default(now())
}

model StudySessionLog {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject         String
  durationMinutes Int
  mode            String   @default("FOCUS")
  loggedAt        DateTime @default(now())
}

model ExpenseTransaction {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Float
  category      String
  paymentMethod String   @default("CARD")
  vendorOrWhere String?
  note          String?
  date          String   // YYYY-MM-DD
  createdAt     DateTime @default(now())
}

model WeeklyCoachCheckIn {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkInDate        String   // YYYY-MM-DD
  previousTdeeKcal   Int
  newTdeeKcal        Int
  tdeeDeltaKcal      Int
  previousTargetKcal Int
  newTargetKcal      Int
  newProteinG        Int
  newCarbsG          Int
  newFatG            Int
  acceptedByUser     Boolean  @default(true)
  createdAt          DateTime @default(now())
}

// Backward compatibility models
model DailyLog {
  id                        String        @id @default(cuid())
  userId                    String
  user                      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  date                      String        // YYYY-MM-DD
  scaleWeightKg             Float?
  trendWeightKg             Float?
  caloriesIn                Int           @default(0)
  proteinG                  Float         @default(0)
  carbsG                    Float         @default(0)
  fatG                      Float         @default(0)
  calculatedExpenditureKcal Int           @default(2400)
  foodItems                 FoodItemLog[]

  @@unique([userId, date])
}

model FoodItemLog {
  id           String   @id @default(cuid())
  dailyLogId   String
  dailyLog     DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  foodName     String
  brand        String?
  barcode      String?
  servingGrams Float
  calories     Float
  protein      Float
  carbs        Float
  fat          Float
  timestamp    DateTime @default(now())
}

model WeeklyCheckIn {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStartDate       String   // YYYY-MM-DD
  previousTDEE        Int
  newTDEE             Int
  recommendedCalories Int
  recommendedProtein  Int
  recommendedCarbs    Int
  recommendedFat      Int
  createdAt           DateTime @default(now())
}
