    // ===============================================================
    // Root Collection: /users/{userId}
    // ===============================================================

    match /users/{userId} {
      // Profile document is strictly private to the authenticated owner.
      // Blanket authentication or cross-user reads are forbidden to protect PII.
      allow read: if isOwner(userId);

      // Create: Allowed only for authenticated user matching userId with valid schema.
      allow create: if isOwner(userId) &&
                       isValidUserProfile(request.resource.data, userId);

      // Update: Allowed only for authenticated owner with valid schema and immutable field guards.
      allow update: if isOwner(userId) &&
                       isValidUserProfile(request.resource.data, userId) &&
                       areImmutableFieldsUnchanged(['email', 'createdAt', 'created_at', 'id', 'uid']);

      // Delete: Allowed only by the authenticated owner.
      allow delete: if isOwner(userId);

      // -------------------------------------------------------------
      // Subcollection 1: /users/{userId}/days/{date}
      // Daily logs, day scores, sleep metrics, and biometrics
      // (Also supports legacy path /dailyLogs/{date})
      // -------------------------------------------------------------
      match /days/{date} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidDayLog(request.resource.data, date, userId);

        allow update: if isOwner(userId) &&
                         isValidDayLog(request.resource.data, date, userId) &&
                         areImmutableFieldsUnchanged(['date', 'log_date', 'createdAt', 'created_at', 'userId', 'user_id', 'id']);

        allow delete: if isOwner(userId);
      }

      match /dailyLogs/{date} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidDayLog(request.resource.data, date, userId);

        allow update: if isOwner(userId) &&
                         isValidDayLog(request.resource.data, date, userId) &&
                         areImmutableFieldsUnchanged(['date', 'log_date', 'createdAt', 'created_at', 'userId', 'user_id', 'id']);

        allow delete: if isOwner(userId);
      }

      // -------------------------------------------------------------
      // Subcollection 2: /users/{userId}/meals/{mealId}
      // Food entries, macros, calories, barcodes, and items breakdown
      // (Also supports legacy path /foodEntries/{mealId})
      // -------------------------------------------------------------
      match /meals/{mealId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidMealEntry(request.resource.data, userId);

        allow update: if isOwner(userId) &&
                         isValidMealEntry(request.resource.data, userId) &&
                         areImmutableFieldsUnchanged(['id', 'userId', 'user_id', 'createdAt', 'created_at']);

        allow delete: if isOwner(userId);
      }

      match /foodEntries/{mealId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidMealEntry(request.resource.data, userId);

        allow update: if isOwner(userId) &&
                         isValidMealEntry(request.resource.data, userId) &&
                         areImmutableFieldsUnchanged(['id', 'userId', 'user_id', 'createdAt', 'created_at']);

        allow delete: if isOwner(userId);
      }

      // -------------------------------------------------------------
      // Subcollection 3: /users/{userId}/workouts/{workoutId}
      // Gym workout sessions, splits, sets, exercises, volume, and PRs
      // -------------------------------------------------------------
      match /workouts/{workoutId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidWorkoutSession(request.resource.data, userId);

        allow update: if isOwner(userId) &&
                         isValidWorkoutSession(request.resource.data, userId) &&
                         areImmutableFieldsUnchanged(['id', 'userId', 'user_id', 'createdAt', 'created_at']);

        allow delete: if isOwner(userId);

        // Optional subcollection for individual workout sets: /workouts/{workoutId}/sets/{setId}
        match /sets/{setId} {
          allow read: if isOwner(userId);

          allow create: if isOwner(userId) &&
                           isValidWorkoutSetItem(request.resource.data, workoutId, userId);

          allow update: if isOwner(userId) &&
                           isValidWorkoutSetItem(request.resource.data, workoutId, userId) &&
                           areImmutableFieldsUnchanged(['id', 'workout_id', 'workoutId', 'user_id', 'userId', 'createdAt']);

          allow delete: if isOwner(userId);
        }
      }

      // -------------------------------------------------------------
      // Subcollection 4: /users/{userId}/focus/{sessionId}
      // Study sessions, focus minutes, pomodoros, and distractions
      // (Also supports legacy path /studySessions/{sessionId})
      // -------------------------------------------------------------
      match /focus/{sessionId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidFocusSession(request.resource.data, userId);

        allow update: if isOwner(userId) &&
                         isValidFocusSession(request.resource.data, userId) &&
                         areImmutableFieldsUnchanged(['id', 'userId', 'user_id', 'createdAt', 'created_at']);

        allow delete: if isOwner(userId);
      }

      match /studySessions/{sessionId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidFocusSession(request.resource.data, userId);

        allow update: if isOwner(userId) &&
                         isValidFocusSession(request.resource.data, userId) &&
                         areImmutableFieldsUnchanged(['id', 'userId', 'user_id', 'createdAt', 'created_at']);

        allow delete: if isOwner(userId);
      }

      // -------------------------------------------------------------
      // Subcollection 5: /users/{userId}/txns/{txnId}
      // Money transactions, expenses, payment methods, and ledger items
      // (Also supports legacy path /transactions/{txnId})
      // -------------------------------------------------------------
      match /txns/{txnId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidTransaction(request.resource.data, userId);

        allow update: if isOwner(userId) &&
                         isValidTransaction(request.resource.data, userId) &&
                         areImmutableFieldsUnchanged(['id', 'userId', 'user_id', 'createdAt', 'created_at']);

        allow delete: if isOwner(userId);
      }

      match /transactions/{txnId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidTransaction(request.resource.data, userId);

        allow update: if isOwner(userId) &&
                         isValidTransaction(request.resource.data, userId) &&
                         areImmutableFieldsUnchanged(['id', 'userId', 'user_id', 'createdAt', 'created_at']);

        allow delete: if isOwner(userId);
      }

      // -------------------------------------------------------------
      // Subcollection 6: /users/{userId}/coach/{checkInId}
      // Weekly coach check-ins, metabolic recommendations, and adjustments
      // (Also supports legacy path /coachCheckIns/{checkInId})
      // -------------------------------------------------------------
      match /coach/{checkInId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidCoachCheckIn(request.resource.data, userId);

        allow update: if isOwner(userId) &&
                         isValidCoachCheckIn(request.resource.data, userId) &&
                         areImmutableFieldsUnchanged(['id', 'userId', 'user_id', 'createdAt', 'created_at', 'checkInDate', 'check_in_date']);

        allow delete: if isOwner(userId);
      }

      match /coachCheckIns/{checkInId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidCoachCheckIn(request.resource.data, userId);

        allow update: if isOwner(userId) &&
                         isValidCoachCheckIn(request.resource.data, userId) &&
                         areImmutableFieldsUnchanged(['id', 'userId', 'user_id', 'createdAt', 'created_at', 'checkInDate', 'check_in_date']);

        allow delete: if isOwner(userId);
      }

      // -------------------------------------------------------------
      // Subcollection 7: /users/{userId}/reviews/{reviewId}
      // Weekly performance reviews, overall grades, telemetry snapshots
      // (Also supports legacy path /aiWeeklyReviews/{reviewId})
      // -------------------------------------------------------------
      match /reviews/{reviewId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidReviewEntry(request.resource.data, userId);

        allow update: if isOwner(userId) &&
                         isValidReviewEntry(request.resource.data, userId) &&
                         areImmutableFieldsUnchanged(['id', 'userId', 'user_id', 'createdAt', 'created_at', 'week_start_date', 'weekStartDate']);

        allow delete: if isOwner(userId);
      }

      match /aiWeeklyReviews/{reviewId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidReviewEntry(request.resource.data, userId);

        allow update: if isOwner(userId) &&
                         isValidReviewEntry(request.resource.data, userId) &&
                         areImmutableFieldsUnchanged(['id', 'userId', 'user_id', 'createdAt', 'created_at', 'week_start_date', 'weekStartDate']);

        allow delete: if isOwner(userId);
      }
    }

    // ===============================================================
    // Root Fallback: Default Deny All Unmatched
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
