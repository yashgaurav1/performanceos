             (!('end_date' in data) || isValidDateString(data.end_date)) &&
             (!('endDate' in data) || isValidDateString(data.endDate)) &&
             isValidOptionalString('overall_grade', 1, 10) &&
             isValidOptionalString('overallGrade', 1, 10) &&
