             hasRequiredFields(['category']) &&
             data.category is string && data.category.size() > 0 && data.category.size() <= 50 &&
             (('amount' in data && data.amount is number && data.amount > 0 && data.amount <= 10000000) ||
              ('amount_minor' in data && data.amount_minor is number && data.amount_minor > 0 && data.amount_minor <= 1000000000) ||
              ('amountMinor' in data && data.amountMinor is number && data.amountMinor > 0 && data.amountMinor <= 1000000000)) &&
             (('date' in data && isValidDateString(data.date)) ||
              ('spent_on' in data && isValidDateString(data.spent_on)) ||
              ('spentOn' in data && isValidDateString(data.spentOn))) &&
             isValidOptionalString('id', 1, 100) &&
             isValidOptionalString('payment_method', 1, 50) &&
             isValidOptionalString('paymentMethod', 1, 50) &&
             isValidOptionalString('vendorOrWhere', 0, 150) &&
             isValidOptionalString('merchant', 0, 150) &&
             isValidOptionalString('note', 0, 1000) &&
             isValidOptionalString('currency_code', 1, 10) &&
             isValidOptionalString('currencyCode', 1, 10) &&
             isValidOptionalBool('is_recurring') &&
             isValidOptionalBool('isRecurring') &&
             isValidOptionalString('sync_status', 1, 50) &&
             isValidOptionalDateTime('client_updated_at') &&
