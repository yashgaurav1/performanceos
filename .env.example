# ==============================================================================
# PerformanceOS - Environment Configuration Reference
# ==============================================================================
# Copy this file to .env.local for local development.
# Configure all required variables in Vercel -> Settings -> Environment Variables.

# ------------------------------------------------------------------------------
# 1. SERVER-SIDE SECRETS (Required for production API routes)
# Do NOT prefix with NEXT_PUBLIC_. These are never exposed to the client bundle.
# ------------------------------------------------------------------------------

# Google Gemini API Key for Neural Coach & Meal Vision
# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# Gemini Model Name (Optional, defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Health check authorization secret (for deep checks)
HEALTH_CHECK_KEY=your-health-check-key

# Firebase Admin Service Account Project ID
FIREBASE_PROJECT_ID=your-firebase-project-id

# Firebase Admin Service Account Client Email
# Obtain from Firebase Console -> Project Settings -> Service accounts
FIREBASE_CLIENT_EMAIL=your-firebase-client-email@your-firebase-project-id.iam.gserviceaccount.com

# Firebase Admin Service Account Private Key
# Paste the full PEM private key including BEGIN and END lines.
# In Vercel, replace literal newlines with \n or paste multi-line directly.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-firebase-private-key\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 2. CLIENT-SIDE PUBLIC FIREBASE CONFIG (Required for Client SDK & Auth)
# These are embedded into the client browser bundle.
# ------------------------------------------------------------------------------

NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-firebase-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your-firebase-measurement-id

# ------------------------------------------------------------------------------
# 3. OPTIONAL SECURITY & APP CHECK
# ------------------------------------------------------------------------------

# Set to true to strictly reject requests missing valid X-Firebase-AppCheck header
ENFORCE_APP_CHECK=false
